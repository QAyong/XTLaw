{
  "schemaVersion": 1,
  "format": "compiled",
  "id": "pcbed1a21022e43b388ccce09fd4647b5.transcript-player",
  "name": "ArtPlayer",
  "description": "用 ArtPlayer 在工作台单独打开音视频，不嵌进文件管理器。",
  "version": "0.1.3",
  "apiVersion": 4,
  "engines": {
    "lexora": ">=0.5.4"
  },
  "permissions": {
    "selectedResource": "read",
    "localResources": true
  },
  "contributes": {
    "views": [
      {
        "id": "pcbed1a21022e43b388ccce09fd4647b5.transcript-player.reader",
        "title": "ArtPlayer",
        "entry": "view.js",
        "resource": "selected-file",
        "location": "context",
        "accepts": {
          "extensions": ["mp4", "m4v", "webm", "mov", "ogv", "mp3", "wav", "ogg", "oga", "opus", "m4a", "aac", "flac"]
        }
      }
    ]
  }
}

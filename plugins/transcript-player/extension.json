{
  "schemaVersion": 1,
  "format": "compiled",
  "id": "pcbed1a21022e43b388ccce09fd4647b5.transcript-player",
  "name": "XTLaw播放器",
  "description": "播放音视频并阅读文字稿，不替换内置播放器的默认打开方式。",
  "version": "0.2.6",
  "icon": "icon.svg",
  "entry": "host.js",
  "apiVersion": 4,
  "engines": {
    "lexora": ">=0.5.4"
  },
  "permissions": {
    "selectedResource": "read",
    "localResources": true,
    "references": true,
    "clipboardWrite": true
  },
  "contributes": {
    "commands": [
      {
        "id": "pcbed1a21022e43b388ccce09fd4647b5.transcript-player.subtitle",
        "title": "记住字幕",
        "hidden": true
      }
    ],
    "views": [
      {
        "id": "pcbed1a21022e43b388ccce09fd4647b5.transcript-player.reader",
        "title": "XTLaw播放器",
        "entry": "view.js",
        "resource": "selected-file",
        "location": "context"
      }
    ],
    "fileHandlers": [
      {
        "id": "pcbed1a21022e43b388ccce09fd4647b5.transcript-player.media",
        "title": "XTLaw播放器",
        "extensions": [
          ".mp4",
          ".m4v",
          ".webm",
          ".mov",
          ".ogv",
          ".mp3",
          ".wav",
          ".ogg",
          ".oga",
          ".opus",
          ".m4a",
          ".aac",
          ".flac"
        ],
        "preview": {
          "view": "pcbed1a21022e43b388ccce09fd4647b5.transcript-player.reader",
          "requestDefault": false
        },
        "open": {
          "view": "pcbed1a21022e43b388ccce09fd4647b5.transcript-player.reader",
          "requestDefault": false
        }
      }
    ]
  }
}

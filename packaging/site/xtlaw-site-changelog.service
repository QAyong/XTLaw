[Unit]
Description=Sync XTLaw website changelog from GitHub Releases
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/xtlaw-site-changelog/sync-changelog.py
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/xtlaw-site
RestrictAddressFamilies=AF_INET AF_INET6
